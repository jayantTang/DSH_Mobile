[Unit]
Description=DSH relay incident alerts -> owner inbox
Documentation=https://github.com/deepseek-ai/dsh
After=network-online.target dsh-relay.service dsh-mail.service
Wants=network-online.target

# 中转把"没见过的异常 / 连接反复断开 / 上游坏字符"写进 /var/lib/dsh-relay/alerts，
# 这一趟取走并投进我们的信箱（见 relay/monitor.py 与 relay/alert-dispatch.py）。
#
# 为什么是独立进程而不是 relay 自己发信：relay 只负责转发，不该持有发信凭据，也
# 不该因为发信慢或失败而影响转发（它的 unit 还是 ProtectSystem=strict 的沙箱）。
#
# 为什么以 root 跑：告警队列属于 dsh-relay（目录 0700），要投的信箱库属于 dsh-mail。
# 跨这两个用户只做这一件事，所以本 unit 只装必要的可执行路径，不写任何用户数据。
[Service]
Type=oneshot
Environment=DLP_ALERT_DIR=/var/lib/dsh-relay/alerts
Environment=DLP_ALERT_MAIL_DB=/var/lib/dsh-mail/mail.db
Environment=DLP_ALERT_MAIL_ADMIN=/opt/dsh-mail/admin.py
Environment=DLP_ALERT_MAIL_PYTHON=/opt/dsh-mail/.venv/bin/python
# 收件账号（owner 本人 = 开发者账号）。真值不写进仓库，由 deploy.sh 在文件不存在时
# 写一份占位模板、由人填；与 apns.env 同一条约定。
EnvironmentFile=-/etc/dsh-relay/alert.env
ExecStart=/opt/dsh-relay/.venv/bin/python /opt/dsh-relay/alert-dispatch.py

Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
# 一次投递最多 60 秒（脚本内部还有自己的超时）；卡住就杀掉，下一趟再试——
# 队列不会丢，失败会把记录放回去。
TimeoutStartSec=120
