[Unit]
Description=DSH Link Protocol (DLP) v1 relay
Documentation=https://github.com/deepseek-ai/dsh
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dsh-relay
Group=dsh-relay
WorkingDirectory=/opt/dsh-relay

# The relay listens on loopback only. Caddy terminates TLS for
# relay.example.com and reverse-proxies /dsh-link/* here (handle_path strips
# the prefix before proxying).
Environment=DLP_HOST=127.0.0.1
Environment=DLP_PORT=8787
Environment=DLP_DB=/var/lib/dsh-relay/state.db
# Optional mount prefix. Caddy's handle_path already strips it, so the relay
# serves root-relative routes; setting it as well makes the relay accept the
# un-stripped /dsh-link/... form too, which keeps the deployment working
# whichever way the front end forwards the request.
Environment=DLP_BASE_PATH=/dsh-link
Environment=DLP_LOG_LEVEL=INFO

# ── 共享带宽的三道闸 ────────────────────────────────────────────────────────
# 这台主机是固定带宽，且带宽由所有设备共享。下面三个值不是"防滥用"，而是
# "别让一个人的一次正常操作拖慢所有人"：
#
#   DLP_MAX_DEVICES_PER_AGENT  一台电脑配几台手机。挡住泄漏的 deviceToken 或
#                              配对脚本把中转塞满；重连不会重复计数。
#   DLP_DEVICE_RATE_KBPS       单设备出口限速（千比特/秒）。取值口径：
#                              「管子 ÷ 预期同时传大文件的设备数」。
#                              实测这台实例是 200 Mbps 固定带宽（2026-09 确认）。
#                              原定 20 Mbps（10 台设备刚好占满管子）实测偏保守：
#                              它把单设备下载压在 1.9 MB/s，而这条链路上真正的大
#                              文件用户通常是 1–2 台自己的手机，所以按「管子 ÷ 2」
#                              定 100 Mbps——两台同时下大文件才刚好占满 200 Mbps。
#                              限速只让设备变慢，不掉帧；真正防滥用的下面那条。
#                              若换成小管子（例如 5 Mbps），按 2–5 Mbps 调。
#   DLP_DEVICE_DAILY_MB        单设备每日（UTC）出口额度。用超会先收到
#                              quota/device-daily 的 error 帧，再被断开（4011），
#                              次日 UTC 零点恢复。**这才是防"把中转当代理/图床"的
#                              那一道**：重度用户一天 100–300 MB（我们自己 16 周
#                              累计才 22 GB），2 GB 留了约 10 倍余量，而拿它当中转
#                              代理的话十几分钟就用完。
#
# 三者留空或为 0 表示不限。改完：
#   systemctl daemon-reload && systemctl restart dsh-relay
# 生效情况与实时流量：
#   curl -s http://127.0.0.1:8787/stats | python3 -m json.tool
Environment=DLP_MAX_DEVICES_PER_AGENT=8
Environment=DLP_DEVICE_RATE_KBPS=100000
Environment=DLP_DEVICE_DAILY_MB=2048
# ProtectSystem=strict makes the filesystem read-only: never write .pyc files.
Environment=PYTHONDONTWRITEBYTECODE=1

ExecStart=/opt/dsh-relay/.venv/bin/python /opt/dsh-relay/relay.py --host 127.0.0.1 --port 8787 --db /var/lib/dsh-relay/state.db
ExecReload=/bin/kill -HUP $MAINPID

Restart=on-failure
RestartSec=2
TimeoutStopSec=15

# ── sandboxing ──────────────────────────────────────────────────────────────
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

# The only writable location: the SQLite database directory.
StateDirectory=dsh-relay
StateDirectoryMode=0700
ReadWritePaths=/var/lib/dsh-relay

LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
