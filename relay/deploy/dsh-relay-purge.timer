[Unit]
Description=DSH Link Protocol (DLP) v1 relay — daily purge of revoked/expired device records
Documentation=https://github.com/deepseek-ai/dsh

[Timer]
# 每天一次：死记录只在连接器重连时被重放，而重连不是每分钟都在发生；
# 清一次就够一天用。定在凌晨而不是零点，是为了错开 relay 跨本地日的用量冲盘，
# 也让"04:30 那条日志"在滚动的 journal 里一眼能认出来。
OnCalendar=*-*-* 04:30:00
# 主机当时关着（维护、重启）就补跑一次，别把那天漏掉。
Persistent=true

[Install]
WantedBy=timers.target
