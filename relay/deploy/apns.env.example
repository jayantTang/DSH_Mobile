# APNs 推送配置（R-1）——**占位符模板，真值只留在服务器上**。
#
# deploy.sh 只在本文件**不存在**时把它写过来；已经有了就一字不动（免得覆盖掉
# 填好的值）。填完：systemctl restart dsh-relay，然后看日志里那行
# 「APNs 已配置 / 未配置」。
#
# ⚠️ 密钥文件放 /etc/dsh-relay/apns/，**不能放 /root 或 /home**：
#    unit 里有 ProtectHome=yes，那些路径在服务自己的命名空间里不存在。
#    仓库里任何地方都不许出现 .p8 的内容，也不许出现真实的 Key ID。

# 总开关。**默认关**：未设或为 0 时 relay 行为和没有推送时逐字一致，
# 只多一行启动日志。填好下面几项、在真机上验过之后再改成 1。
DLP_APNS_ENABLED=0

# APNs 专用 .p8 的**绝对路径**（不是内容，也不进仓库）。
# 申请：developer.apple.com → Keys → ＋ → 「Apple Push Notifications service (APNs)」。
# .p8 只能下载一次；Key ID 就是文件名里那一段。
# 注意：App Store Connect API key（AuthKey_XXXXXXXXXX.p8）**不能**当 APNs key 用。
DLP_APNS_KEY_PATH=/etc/dsh-relay/apns/AuthKey_KEYID1234.p8

# 上面那张 key 的 Key ID（10 位）与开发者 Team ID（10 位）。
DLP_APNS_KEY_ID=KEYID1234
DLP_APNS_TEAM_ID=TEAMID1234

# App 的 bundle id，也就是 apns-topic。
DLP_APNS_TOPIC=com.example.app

# 设备没上报环境时用的兜底。真机用 OTA 开发版装的是 sandbox，
# TestFlight / App Store 版是 production（App 每次上报都会带自己的环境，
# 所以这一项基本只是兜底）。
DLP_APNS_ENV_DEFAULT=sandbox

# 每台设备两条推送之间的最小间隔（秒），用来防止一次抖动把锁屏刷满。
# 0 = 不节流。
DLP_APNS_MIN_INTERVAL_S=60
