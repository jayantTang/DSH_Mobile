# ─────────────────────────────────────────────────────────────────────────────
# DSH mail service route fragment (DESIGN-20261015 M3).
#
# This is NOT a site block. mail/deploy/deploy.sh inserts it *inside* the
# existing site block that serves the configured site address (default
# relay.example.com), before the first handle / handle_path / route /
# reverse_proxy directive — the same position the relay's own fragment takes.
#
#   sudo mail/deploy/deploy.sh              enable / update
#   sudo mail/deploy/deploy.sh --uninstall  revert (removes the marked block)
#
# Why it is written this way:
#   * The app derives its feedback endpoint from the PAIRED RELAY URL, so the
#     public path stays `<site>/dsh-link/feedback/*` after the split — zero app
#     change, old binaries keep working (DESIGN-20261015 假设 2).
#   * `handle` (not `handle_path`) with `uri strip_prefix /dsh-link`: only the
#     /dsh-link prefix is stripped, so the mail service serves root-relative
#     /feedback/* exactly like the relay did. Caddy prefers the most specific
#     path between `handle` blocks, so this wins over the relay's
#     `handle_path /dsh-link/*` regardless of file order — the same mechanism
#     the relay's own /stats reject relies on, pinned by a runtime test in M5.
#   * Timeouts are normal request/response values (30s), NOT the infinite ones
#     the DLP websocket block needs — feedback is short HTTP, and a stuck
#     client must not hold a connection forever.
#   * header_up X-Real-IP / X-Forwarded-For: the mail service rate-limits by
#     client address and only trusts these headers from a loopback peer, same
#     rule as the relay (replaces, never appends — measured on Caddy v2.11.4).
# ─────────────────────────────────────────────────────────────────────────────
handle /dsh-link/feedback/* {
	uri strip_prefix /dsh-link
	# 压缩只加在这个 handle 块内（站点级会改到中转的 WS 路由）：收件箱响应 6.95 MB
	# 降到 1.2 MB 量级。Caddy 默认 minimum_length 512，小响应不压缩属预期。
	encode zstd gzip
	reverse_proxy 127.0.0.1:8788 {
		transport http {
			dial_timeout 5s
			read_timeout 30s
			write_timeout 30s
			keepalive 60s
			keepalive_idle_conns 4
		}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
	}
}
