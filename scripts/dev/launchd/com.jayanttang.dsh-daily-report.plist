<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.jayanttang.dsh-daily-report —— 014 运营日报的 LaunchAgent 模板。

  安装不在本文件上手工做，走：
      node scripts/dev/feedback.mjs report --install-agent
  脚本把占位符换成这台机器的真值后写到 ~/Library/LaunchAgents/ 再 launchctl bootstrap：
      __NODE__   → 当前 node 的绝对路径（launchd 没有 PATH，必须绝对路径）
      __REPO__   → 仓库根（ProgramArguments 与 WorkingDirectory 都用它）
      ~/…        → 真实家目录（launchd 不展开 ~，模板里保留 ~ 只为可读）
  卸载：node scripts/dev/feedback.mjs report --uninstall-agent

  触发时刻：每天 **00:02**（owner 2026-10-12 要求改成"晚上 12 点、发刚过去的一整天"）。
  为什么不是 00:00 整点：中转的用量记账是攒在内存里、每 30 秒冲一次盘（`hub.py` 的
  `usage_flush_interval`），整点那一刻上一天的尾巴还没落库，日报会少最后一小段；
  过了跨日那一跳（≤30 秒）再跑就是完整一天。`--full-day` 让报告覆盖昨天 00:00–23:59。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jayanttang.dsh-daily-report</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__REPO__/scripts/dev/feedback.mjs</string>
    <string>report</string>
    <string>--days</string>
    <string>30</string>
    <string>--full-day</string>__SEND_ARGS__
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>RunAtLoad</key>
  <false/>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>0</integer>
    <key>Minute</key>
    <integer>2</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>~/Library/Logs/dsh-daily-report.log</string>
  <key>StandardErrorPath</key>
  <string>~/Library/Logs/dsh-daily-report.log</string>
</dict>
</plist>
