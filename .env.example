# 本机部署配置模板。
#
# 复制成 .env.local 再填真值；.env.local 不入库（见 .gitignore）。
# 仓库里所有部署地址一律是占位符（relay.example.com 之类），真实地址只存在于本机。
#
#   cp .env.example .env.local && $EDITOR .env.local

# 中转站点：Caddy 里承载 /dsh-link 与 /ios 的那个站点块，例 your.host
DSH_SITE=relay.example.com

# 中转基址（含路径前缀）：插件默认值、探针、iOS App 默认中转地址都用它
DSH_RELAY_URL=wss://relay.example.com/dsh-link

# OTA 与博客发布脚本连的远端主机，通常与 DSH_SITE 相同
DSH_OTA_HOST=relay.example.com

# DSH 的安装目录（含 package.json 的那层）。仅当 DSH 装在非默认位置、插件
# 解析不到它自带的模块（ws / @deepseek-ai/cordis）时才需要设置；默认按
# $DSH_HOME → PATH 上的 dsh → npm root -g 的顺序自动推导。
# DSH_INSTALL_DIR=/opt/homebrew/lib/node_modules/@deepseek-ai/dsh

# Apple 开发者团队 ID。也可以写在 ios/DSHMobile/Signing.local.plist（同样不入库）
# DSH_TEAM_ID=XXXXXXXXXX
